<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cineticket.desktop.ui.controller.SeatSelectionController" styleClass="seat-page">
    <top><HBox styleClass="seat-nav"><Label text="CINE•TICKET" styleClass="seat-brand"/><Region HBox.hgrow="ALWAYS"/>
        <Button text="Trang chủ" onAction="#goHome" styleClass="seat-nav-link"/><Button text="Vé của tôi" onAction="#goHistory" styleClass="seat-nav-link"/>
        <Label fx:id="userLabel" styleClass="seat-nav-user"/><Button text="Đăng xuất" onAction="#logout" styleClass="seat-nav-button"/></HBox></top>
    <center><HBox>
        <VBox spacing="18" HBox.hgrow="ALWAYS" styleClass="seat-map-panel">
            <Button text="‹  Quay lại lịch chiếu" onAction="#back" styleClass="seat-back-button"/>
            <VBox spacing="4" alignment="CENTER"><Label text="CHỌN GHẾ CỦA BẠN" styleClass="seat-page-title"/><Label fx:id="showtimeLabel" styleClass="seat-subtitle"/></VBox>
            <VBox spacing="8" alignment="CENTER"><Label text="M À N  H Ì N H" styleClass="screen-label"/><Region styleClass="cinema-screen" maxWidth="820"/></VBox>
            <StackPane VBox.vgrow="ALWAYS"><GridPane fx:id="seatGrid" hgap="13" vgap="14" alignment="CENTER"/></StackPane>
            <HBox alignment="CENTER" spacing="36" styleClass="seat-legend">
                <HBox spacing="8"><Region styleClass="legend-available"/><Label text="Còn trống"/></HBox>
                <HBox spacing="8"><Region styleClass="legend-selected"/><Label text="Đang chọn"/></HBox>
                <HBox spacing="8"><Region styleClass="legend-unavailable"/><Label text="Đã đặt"/></HBox>
            </HBox>
        </VBox>
        <VBox styleClass="seat-summary-panel" prefWidth="390" minWidth="350" spacing="20">
            <Label text="TÓM TẮT ĐẶT VÉ" styleClass="summary-heading"/><Separator styleClass="summary-separator"/>
            <HBox spacing="18"><ImageView fx:id="summaryPoster" fitWidth="105" fitHeight="150" preserveRatio="false"/>
                <VBox spacing="8"><Label fx:id="movieLabel" styleClass="summary-movie-title" wrapText="true" maxWidth="205"/><Label text="CineTicket Cinema" styleClass="summary-muted"/><Label text="Phòng chiếu tiêu chuẩn" styleClass="summary-muted" wrapText="true"/></VBox>
            </HBox>
            <Separator styleClass="summary-separator"/>
            <HBox><Label text="Ghế của bạn" styleClass="summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="selectedSeatsLabel" wrapText="true" styleClass="summary-value"/></HBox>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox><Label text="Tổng cộng" styleClass="summary-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="totalLabel" styleClass="summary-total"/></HBox>
            <Label text="Ghế được giữ 5 phút sau khi bạn tiếp tục. Thanh toán trong đồ án là mô phỏng." styleClass="summary-note" wrapText="true"/>
            <Button fx:id="continueButton" text="TIẾP TỤC ĐẾN THANH TOÁN" onAction="#continueToCheckout" styleClass="summary-continue-button" maxWidth="Infinity" disable="true"/>
        </VBox>
    </HBox></center>
</BorderPane>
